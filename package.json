{
  "name": "foxwallet-extension",
  "version": "0.15.0",
  "description": "FoxWallet chrome extension",
  "type": "module",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build:dev": "wxt build --mode development",
    "build:prod": "wxt build",
    "test:dapp": "node --test tests/dapp-messaging.test.mjs",
    "test:rpc": "node --test tests/rpc-server.test.mjs",
    "clean": "wxt clean",
    "translate": "node ./scripts/translate.cjs",
    "lint": "eslint --quiet --ext .ts,.tsx,.js,.jsx --fix .",
    "eslint-find-rules": "eslint-find-rules",
    "format": "prettier --write .",
    "sdk:patch": "node scripts/gen_sdk_patch.cjs",
    "postinstall": "patch-package --error-on-fail && node scripts/wasm_static.cjs && wxt prepare",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsc --noEmit && tsc --noEmit -p offscreen_service/tsconfig.json",
    "test:store": "node --test tests/store.test.mjs",
    "test:aleo": "node --test tests/aleo-wasm.test.mjs",
    "test:scanner": "node --test tests/scanner.test.mjs",
    "test:sidepanel": "node --test tests/sidepanel.test.mjs",
    "test:aleo:dev": "node --experimental-vm-modules --test tests/aleo-dev-worker.test.mjs"
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx}": [
      "npm run format",
      "npm run lint"
    ]
  },
